# eval/opentraces/probes — keep lightweight analysis artifacts, never commit raw trajectory data.
# The raw episode trees here total ~10GB (m5-run/episodes alone is 7.2GB). They stay local.

# Per-episode driver trajectories at any depth
episodes/

# Bulky per-run logs (full audit trail kept locally, re-derivable)
runner-log.jsonl

