{
  "name": "datafetch",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayFarei/datafetch.git"
  },
  "bin": {
    "datafetch": "./bin/datafetch.mjs"
  },
  "scripts": {
    "datafetch": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts demo",
    "eval:skillcraft": "tsx eval/harness/skillcraftFullDatafetch.ts",
    "datafetch:run": "tsx eval/harness/runScript.ts",
    "eval:skillcraft:synthetic": "tsx eval/harness/skillcraftDatafetch.ts",
    "eval:skillcraft:synthetic:live": "tsx eval/harness/skillcraftDatafetch.ts --live",
    "eval:skillcraft:synthetic:live:fast": "tsx eval/harness/skillcraftDatafetch.ts --live --warm-fast-path",
    "eval:skillcraft:synthetic:live:smoke": "tsx eval/harness/skillcraftDatafetch.ts --live --smoke",
    "eval:skillcraft:prepare": "bash eval/skillcraft/scripts/prepare-skillcraft.sh",
    "eval:skillcraft:native:claw": "bash eval/skillcraft/scripts/run-native-claw-codex.sh",
    "eval:skillcraft:normalize": "tsx eval/skillcraft/scripts/normalize-results.ts",
    "eval:skillcraft:analyze": "tsx eval/skillcraft/scripts/analyze-results.ts",
    "eval:skillcraft:report": "tsx eval/skillcraft/scripts/build-report.ts",
    "eval:skillcraft:verify": "tsx eval/skillcraft/scripts/verify-harness.ts",
    "eval:skillcraft:preflight": "tsx eval/skillcraft/scripts/check-native-readiness.ts",
    "eval:finchain": "tsx eval/harness/finchainFullDatafetch.ts",
    "eval:finchain:prepare": "bash eval/finchain/scripts/prepare-finchain.sh",
    "eval:finchain:normalize": "tsx eval/finchain/scripts/normalize-results.ts",
    "eval:finchain:analyze": "tsx eval/finchain/scripts/analyze-results.ts",
    "eval:finchain:report": "tsx eval/finchain/scripts/build-report.ts",
    "eval:finchain:score": "tsx eval/finchain/scripts/score-finchain.ts",
    "eval:finchain:walk-artifacts": "tsx eval/finchain/scripts/walk-artifacts.ts",
    "eval:finchain:verify": "tsx src/observer/__smoke__/finchain-mount.ts",
    "eval:finchain:sweep": "tsx eval/finchain/scripts/sweep.ts",
    "test": "tsx src/snippet/__smoke__.ts && tsx src/snippet/__sdk_import_smoke__.ts && tsx src/observer/__smoke__/finqa.ts && tsx src/observer/__smoke__/novel-tenant.ts && tsx src/observer/__smoke__/cross-shape-transfer.ts && tsx src/bash/__smoke__.ts && tsx src/observer/__smoke__/finchain-mount.ts && tsx src/observer/__smoke__/author-from-source.ts && vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "acceptance": "bash tests/acceptance/run-all.sh",
    "acceptance:help": "bash tests/acceptance/run-all.sh --help",
    "api": "tsx watch src/server/server.ts",
    "api:once": "tsx src/server/server.ts",
    "web": "pnpm --dir web dev",
    "web:install": "pnpm --dir web install",
    "ladder:gen-fixtures": "tsx eval/ladder/scripts/gen-substrate-fixtures.ts",
    "ladder:replay": "bin/ladder-replay"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@flue/sdk": "^0.3.6",
    "@hono/node-server": "^2.0.1",
    "hono": "^4.12.16",
    "just-bash": "^2.14.4",
    "mongodb": "^6.21.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@flue/cli": "0.3.6",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.0",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
